APP_NAME=COVID Analytics API
APP_ENV=development
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./covid_analytics.db
AUTO_LOAD_ON_STARTUP=true
DEFAULT_FORECAST_HORIZON=14
TREND_SURGE_RATIO_THRESHOLD=1.35
TREND_MODERATE_RATIO_THRESHOLD=1.10
TREND_SURGE_GROWTH_THRESHOLD=0.20
TREND_MODERATE_GROWTH_THRESHOLD=0.05
LSTM_WINDOW=14
LSTM_EPOCHS=12
LSTM_BATCH_SIZE=16
XGB_ESTIMATORS=240
COVID_DAILY_DATA_PATH=./data/raw/WHO-COVID-19-global-daily-data.csv
COVID_WEEKLY_DATA_PATH=./data/raw/WHO-COVID-19-global-data.csv
COVID_HOSPITAL_DATA_PATH=./data/raw/WHO-COVID-19-global-hosp-icu-data.csv
COVID_VACCINATION_DATA_PATH=./data/raw/COV_VAC_UPTAKE_2024.csv
